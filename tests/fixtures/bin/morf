#!/bin/sh
# A stand-in for morf in the command-line specs: logs each call and the files it
# was handed to $STUB_LOG, and answers `ipc verbs` while $STUB_UP is set.
printf '%s EVA_SETTINGS=%s EVA_APPEARANCE=%s\n' "$*" "${EVA_SETTINGS:-}" "${EVA_APPEARANCE:-}" >> "$STUB_LOG"
if [ "$1 $2" = "ipc verbs" ]; then
  [ -n "${STUB_UP:-}" ] || exit 1
  printf '{"n":4,"ok":true,"result":["dashboard","launcher","notify","settings"]}\n'
fi
exit 0
