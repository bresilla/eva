#!/bin/sh
# A stand-in for morf in the command-line specs: logs each call to $STUB_LOG and
# answers `ipc verbs` while $STUB_UP is set.
printf '%s\n' "$*" >> "$STUB_LOG"
if [ "$1 $2" = "ipc verbs" ]; then
  [ -n "${STUB_UP:-}" ] || exit 1
  printf 'launcher\ndashboard\nsettings\nnotify\n'
fi
exit 0
