#!/bin/sh
# A stand-in for morf in the command-line specs: logs each call and the files it
# was handed to $STUB_LOG, answers `ipc verbs` while $STUB_UP is set, and, named
# by `-i`, as the capture tool while $STUB_TOOL is set: `record state` from
# $STUB_RECORD, and a `result=FILE` word filled from $STUB_RESULT.
printf '%s EVA_SETTINGS=%s EVA_APPEARANCE=%s\n' "$*" "${EVA_SETTINGS:-}" "${EVA_APPEARANCE:-}" >> "$STUB_LOG"
for word in "$@"; do
  case "$word" in
    result=*) printf '%b' "${STUB_RESULT-ok\n/home/stub/Pictures/Captures/capture_stub.png\n}" > "${word#result=}" ;;
  esac
done
if [ "$1" = -i ]; then
  [ "$3 $4" = "ipc verbs" ] && { [ -n "${STUB_TOOL:-}" ] || exit 1; printf '{"n":1,"ok":true,"result":["capture"]}\n'; }
  [ "$3 $4 $5 $6" = "ipc call record state" ] && printf '{"n":1,"ok":true,"result":["%s"]}\n' "${STUB_RECORD:-idle}"
  [ "$3 $4 $5 $6" = "ipc call record stop" ] && printf '{"n":1,"ok":true,"result":["%s"]}\n' "${STUB_RECORD:-}"
  exit 0
fi
if [ "$1 $2" = "ipc verbs" ]; then
  [ -n "${STUB_UP:-}" ] || exit 1
  printf '{"n":4,"ok":true,"result":["dashboard","launcher","notify","settings"]}\n'
fi
exit 0
