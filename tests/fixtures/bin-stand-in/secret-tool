#!/bin/sh
# Stands in for secret-tool: a private folder for a keyring. Its calls are
# logged to STUB_LOG, what it is given on stdin never.
store=${SECRET_STAND_IN:?the stand-in needs SECRET_STAND_IN, a folder of its own}
mkdir -p "$store"
chmod 700 "$store"
printf 'secret-tool %s\n' "$*" >> "${STUB_LOG:-/dev/null}"
verb=$1
shift
name=""
for word in "$@"; do
  case "$word" in
    --label=*) ;;
    *) name="$name-$word" ;;
  esac
done
file=$store/$(printf '%s' "$name" | tr -c 'A-Za-z0-9' '_')
case "$verb" in
  store) cat > "$file" ;;
  lookup) [ -e "$file" ] && cat "$file" ;;
  clear) rm -f "$file" ;;
  *) exit 2 ;;
esac
exit 0
