#!/bin/sh
# eva-screenshot: the capture tool. The panel, the frozen selection, the editor
# and the recorder, with or without the shell.
#
#   eva-screenshot                                   the panel
#   eva-screenshot region|window|screen [--edit|--copy|--save|--pin] [--delay N] [--last]
#   eva-screenshot ocr|qr [region|window|screen]     copies what it reads
#   eva-screenshot scroll [region|window|screen]     a long picture as a window scrolls
#   eva-screenshot --edit-file FILE                  the editor on a picture or recording
#   eva-screenshot --pin-file FILE                   keeps a picture over the windows
#   eva-screenshot --text FILE                       prints the text in a picture
#   eva-screenshot --ask VERB [ARGS]                 a verb of the tool, kept ready
#
# Everything goes through the selection: --edit (the default) opens the editor
# on it, --copy puts it on the clipboard, --save writes it to the captures
# folder, --pin keeps it over the windows until pressed. --last takes the region
# taken last. What ocr and qr read goes to the clipboard, never to a file.
set -eu
apps=$(dirname -- "$(dirname -- "$(readlink -f -- "$0")")")
. "$apps/common/cli.sh"

target=""
how=edit
delay=""
last=""
reader=""
tool=""
long=""

# A verb of the tool: the one running hears it, or a new one starts with it.
order() {
  if eva_dry; then
    eva_say "dry run: $*"
    return 0
  fi
  if eva_capture_up; then
    eva_capture_call "$@" > /dev/null
    return 0
  fi
  sh "$apps/launch" screenshot "$@" > /dev/null 2>&1 &
  tool=$!
}

tool_alive() {
  if [ -n "$tool" ]; then kill -0 "$tool" 2> /dev/null; else eva_capture_up; fi
}

# Waits for what the tool writes to file $1: "ok" or "no", then a line. Answers
# with that line in $answer.
outcome() {
  while [ ! -s "$1" ] && tool_alive; do sleep 0.1; done
  answer=$(tail -n +2 "$1" 2> /dev/null || true)
  [ "$(head -n 1 "$1" 2> /dev/null || true)" = ok ]
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    region | window | screen) target=$1 ;;
    ocr | qr) reader=$1 ;;
    scroll) long=1 ;;
    --edit) how=edit ;;
    --copy) how=copy ;;
    --save) how=save ;;
    --pin) how=pin ;;
    --last) last=1 ;;
    --edit-file)
      shift
      order capture-editor file "${1:?--edit-file takes a file}"
      if [ -n "$tool" ]; then wait "$tool" || true; fi
      exit 0
      ;;
    --pin-file)
      shift
      order capture-pin add "$(readlink -f -- "${1:?--pin-file takes a file}")"
      exit 0
      ;;
    --text)
      shift
      if ! eva_has tesseract; then
        eva_say "tesseract is not installed, so no text can be read from a shot"
        exit 1
      fi
      exec tesseract "${1:?--text takes a file}" - 2> /dev/null
      ;;
    --ask)
      shift
      if eva_capture_call "$@" > /dev/null 2>&1; then exit 0; fi
      # Nothing to shut in a tool that is not running.
      case "${1:-} ${2:-}" in
        "capture close" | "capture state" | "capture-editor cancel" | "capture-claim "* | "reload "*) exit 0 ;;
      esac
      # The shell keeps it ready; with no shell it does this and ends.
      if ! eva_shell_up; then exec sh "$apps/launch" screenshot "$@"; fi
      [ "${1:-}" != standby ] || shift
      exec sh "$apps/launch" screenshot standby "$@"
      ;;
    --saved-picture)
      shift
      eva_thumbnail "$1" "$1" "Capture saved" "$apps/screenshot/cli"
      exit 0
      ;;
    --saved-recording)
      shift
      if frame=$(eva_poster "$1"); then
        eva_thumbnail "$frame" "$1" "Recording saved"
        rm -f "$frame"
      else
        eva_notify "Recording saved" "$1"
      fi
      exit 0
      ;;
    --delay)
      shift
      delay=${1:?--delay takes seconds}
      ;;
    --delay=*) delay=${1#--delay=} ;;
    -h | --help)
      sed -n '2,/^$/s/^# \{0,1\}//p' "$0"
      exit 0
      ;;
    *)
      eva_say "unknown argument: $1"
      exit 2
      ;;
  esac
  shift
done

case "$delay" in
  '' | *[!0-9]*)
    if [ -n "$delay" ]; then
      eva_say "--delay takes whole seconds"
      exit 2
    fi
    ;;
esac

if [ -n "$long" ]; then
  order capture-scroll "${target:-window}"
  if [ -n "$tool" ]; then wait "$tool" || true; fi
  exit 0
fi

if [ -z "$target" ] && [ -z "$reader" ]; then
  order capture open
  if [ -n "$tool" ]; then wait "$tool" || true; fi
  exit 0
fi

if [ -n "$reader" ]; then
  case "$reader" in
    ocr) program=tesseract ;;
    qr) program=zbarimg ;;
  esac
  if ! eva_has "$program"; then
    eva_say "$program is not installed"
    exit 1
  fi
  how=$reader
  target=${target:-region}
fi

set -- screenshot "$target" "how=$how"
if [ -n "$delay" ]; then set -- "$@" "delay=$delay"; fi
if [ -n "$last" ]; then set -- "$@" last=1; fi

# The editor is the person's from here; the rest are told how they went.
if [ "$how" = edit ]; then
  order "$@"
  if [ -n "$tool" ]; then wait "$tool" || true; fi
  exit 0
fi

result=$(eva_private_file txt)
trap 'rm -f "$result"' EXIT
order "$@" "result=$result"
eva_dry && exit 0
status=1
if outcome "$result"; then status=0; fi
# The tool may stay a while for its thumbnail; only a failure is waited on.
if [ "$status" -ne 0 ] && [ -n "$tool" ]; then wait "$tool" || true; fi
if [ "$status" -ne 0 ]; then
  eva_say "${answer:-the capture did not finish}"
  exit 1
fi
if [ "$how" = save ]; then printf '%s\n' "$answer"; fi
