#!/bin/sh
# eva-battery: the battery's charge limit from a command line, the same code as
# the Power page's switch (lib/services/charge_limit.lua).
#
#   eva-battery status        the charge, and the limit where there is one
#   eva-battery limit on      charging stops at the limit set for this battery
#   eva-battery limit off     charging goes to full
set -eu
apps=$(dirname -- "$(dirname -- "$(readlink -f -- "$0")")")
. "$apps/common/cli.sh"

case "${1:-status}" in
  status | limit) eva_job battery "${1:-status}" ${2:+"$2"} ;;
  -h | --help | help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0" ;;
  *)
    eva_say "unknown command: $1"
    exit 2
    ;;
esac
