#!/bin/sh
# eva-info: about this machine. Every fact is on the Settings window's About
# page; as words they come from shell/info_model.lua, run as a job.
#
#   eva-info            the Settings window, on About
#   eva-info --text     every fact, for a paste
#   eva-info --json     every fact, for a program
#   eva-info --copy     every fact as words, on the clipboard
set -eu
apps=$(dirname -- "$(dirname -- "$(readlink -f -- "$0")")")
. "$apps/common/cli.sh"

case "${1:-}" in
  '') eva_settings about ;;
  -h | --help | help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0" ;;
  --json | --text) eva_job info "$1" ;;
  --copy)
    if eva_dry; then
      eva_say "would copy the facts (dry run)"
    elif eva_has wl-copy; then
      eva_job info --text | wl-copy
    else
      eva_say "wl-copy is not installed"
      exit 1
    fi
    ;;
  *)
    eva_say "no such option: $1"
    exit 1
    ;;
esac
