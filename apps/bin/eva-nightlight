#!/bin/sh
# eva-nightlight: the shell's night light from a command line. The tile and
# this are one thing: lib/services/nightlight.lua, its state the shell's
# settings. With the shell down it runs the same code as a job.
#
#   eva-nightlight on [KELVIN]      warm now
#   eva-nightlight off              back to normal
#   eva-nightlight toggle [KELVIN]
#   eva-nightlight status           on or off
#   eva-nightlight temperature [K]  how warm, or set it
#   eva-nightlight follow [on|off]  whether it follows the sun
#   eva-nightlight times            today's sunrise and sunset, in UTC
#   eva-nightlight auto             on after sunset, off after sunrise, once
#   eva-nightlight daemon           auto, every five minutes, with no shell
#
# The place is the shell's services.weather_location, a name or "LAT,LON";
# EVA_NIGHTLIGHT_PLACE names another. EVA_NOW is the time, for tests.
set -eu
apps=$(dirname -- "$(dirname -- "$(readlink -f -- "$0")")")
. "$apps/common/cli.sh"

case "${1:-status}" in
  on | off | toggle | status | temperature | follow)
    if eva_shell_up; then
      eva_ipc nightlight "${1:-status}" ${2:+"$2"} | eva_answer
      exit
    fi
    ;;
  times | auto | daemon) ;;
  -h | --help | help)
    sed -n '2,/^$/s/^# \{0,1\}//p' "$0"
    exit 0
    ;;
  *)
    eva_say "unknown command: $1"
    exit 2
    ;;
esac

eva_job nightlight "${1:-status}" ${2:+"$2"}
