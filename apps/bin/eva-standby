#!/bin/sh
# eva-standby: the shell's StandBy on demand, on any form: the clock, pictures,
# widgets, the world and the next alarm, the screen awake while it shows.
#
#   eva-standby                   opens it; a second call closes it
#   eva-standby --when-charging   ends by itself when the power is unplugged
#   eva-standby --night           dim red, whatever the hour
set -eu
apps=$(dirname -- "$(dirname -- "$(readlink -f -- "$0")")")
. "$apps/common/cli.sh"

how=toggle
words=
for word in "$@"; do
  case "$word" in
    --when-charging) how=on words="$words when-charging" ;;
    --night) how=on words="$words night" ;;
    -h | --help | help)
      sed -n '2,/^$/s/^# \{0,1\}//p' "$0"
      exit 0
      ;;
    *)
      eva_say "unknown option: $word"
      exit 2
      ;;
  esac
done

if ! eva_shell_up; then
  eva_say "StandBy is the shell's: it is not running"
  exit 1
fi
# shellcheck disable=SC2086
eva_ipc standby "$how" $words > /dev/null
