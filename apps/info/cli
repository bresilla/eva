#!/bin/sh
# eva-info: about this machine, in a window or as words.
#
#   eva-info            the window
#   eva-info --text     every fact, for a paste
#   eva-info --json     every fact, for a program
#   eva-info --copy     every fact as words, on the clipboard
set -eu
apps=$(dirname -- "$(dirname -- "$(readlink -f -- "$0")")")
. "$apps/common/cli.sh"

# The facts, by the tool's own code with no window.
facts() {
  out=$(eva_private_file info)
  EVA_INFO_OUT=$out "${MORF:-morf}" app "$apps/info/app.lua" -- "$1" > /dev/null 2>&1 || true
  cat "$out"
  rm -f "$out"
}

case "${1:-}" in
  '') exec sh "$apps/launch" info ;;
  -h | --help | help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0" ;;
  --json | --text) facts "$1" ;;
  --copy)
    if eva_dry; then
      eva_say "would copy the facts (dry run)"
    elif eva_has wl-copy; then
      facts --text | wl-copy
    else
      eva_say "wl-copy is not installed"
      exit 1
    fi
    ;;
  *)
    eva_say "no such option: $1"
    exit 1
    ;;
esac
