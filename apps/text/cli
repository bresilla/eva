#!/bin/sh
# eva-text: a developer's scratchpad, and its transforms on a command line. Text
# comes from stdin, or from the words after a transform on a terminal.
#
#   eva-text                     the Tools window, on Text
#   eva-text list                every transform
#   eva-text TRANSFORM < FILE    upper, sort, dedupe, json, sha256, md5, epoch...
#   eva-text base64 [-d] < FILE  also url and hex, -d decoding
#   eva-text uuid
#   eva-text lorem [PARAGRAPHS]
#   eva-text password [LENGTH] [--no-symbols]
#   eva-text passphrase [WORDS]
set -eu
apps=$(dirname -- "$(dirname -- "$(readlink -f -- "$0")")")
. "$apps/common/cli.sh"

case "${1:-}" in
  '') eva_tools text ;;
  -h | --help | help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0" ;;
  list | uuid | lorem | password | passphrase) eva_tool_job text "$@" ;;
  *)
    if [ -t 0 ]; then
      eva_tool_job text "$@"
    else
      eva_tool_job_stdin text "$@"
    fi
    ;;
esac
