#!/bin/sh
# eva-audio: the full mixer, on the shell's own sound pages: what plays and what
# records, where each goes, each device's channels, the equalizer.
#
#   eva-audio               the window
#   eva-audio next          the next output becomes the default, for a key
#   eva-audio next input    the next input
#   eva-audio list          the devices, and the apps that use them
set -eu
apps=$(dirname -- "$(dirname -- "$(readlink -f -- "$0")")")
. "$apps/common/cli.sh"
. "$apps/job.sh"

case "${1:-}" in
  '') exec sh "$apps/launch" audio ;;
  -h | --help | help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0" ;;
  *) eva_tool_job audio "$@" ;;
esac
