#!/bin/sh
# apps/launch TOOL [ARGS]: one tool of apps/ as a program of its own. With no
# ARGS it is the tool's overlay, and one at a time: a second launch answers the
# first, which shuts, and ends. With ARGS it is a job or a daemon, which runs
# beside it.
#
# MORF is the binary (default: morf on PATH). EVA_APPEARANCE and EVA_SETTINGS
# name the shell's files; unset, they are found here.
set -eu
here=$(dirname -- "$(readlink -f -- "$0")")
tool=${1:?usage: apps/launch TOOL [ARGS]}
shift
[ -f "$here/$tool/app.lua" ] || { echo "eva: no tool $tool" >&2; exit 1; }

state=${XDG_STATE_HOME:-$HOME/.local/state}

# The appearance the NixOS launcher gives the shell.
if [ -z "${EVA_APPEARANCE:-}" ] && [ -r "$state/eva/appearance/appearance.json" ]; then
  export EVA_APPEARANCE="$state/eva/appearance/appearance.json"
fi

# The settings file the shell last named, else the newest one it left.
if [ -z "${EVA_SETTINGS:-}" ]; then
  named=$(cat "$state/eva/settings-path" 2>/dev/null || true)
  [ -n "$named" ] || named=$(ls -t "$state"/morf/*/eva.json 2>/dev/null | head -n 1 || true)
  if [ -n "$named" ]; then export EVA_SETTINGS="$named"; fi
fi

# The capture tool: a plain morf on every screen, named by a socket of its own.
if [ "$tool" = screenshot ]; then
  [ "$#" -gt 0 ] || set -- capture open
  display=${WAYLAND_DISPLAY:-wayland-0}
  unset MORF_APP
  exec "${MORF:-morf}" -i "${display##*/}-screenshot" "$here/$tool/app.lua" -- "$@"
fi

if [ "$#" -gt 0 ]; then
  exec "${MORF:-morf}" app "$here/$tool/app.lua" -- "$@"
fi

# The pid of this tool while it is up: the launcher's own, which `exec` hands
# to morf.
guard_dir=${XDG_RUNTIME_DIR:-/tmp}/eva
guard=$guard_dir/$tool.window
mkdir -p "$guard_dir"
chmod 700 "$guard_dir" 2>/dev/null || true

open_window() {
  pid=$(cat "$guard" 2>/dev/null || true)
  [ -n "$pid" ] && grep -qa "$tool/app.lua" "/proc/$pid/cmdline" 2>/dev/null
}

if ! (set -C; printf '%s' "$$" > "$guard") 2>/dev/null; then
  if open_window; then
    env -u MORF_APP "${MORF:-morf}" -i "$(basename -- "${WAYLAND_DISPLAY:-wayland-0}")-app-$pid" \
      ipc call eva-raise > /dev/null 2>&1 || true
    exit 0
  fi
  printf '%s' "$$" > "$guard"
fi
exec "${MORF:-morf}" app "$here/$tool/app.lua"
