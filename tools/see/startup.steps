# eva-startup on the sealed session: real files in the scratch XDG folders, the
# launcher's own list of installed apps, and a stand-in for systemd's timers,
# which this session does not have.
unset EVA_DRY_RUN
export EVA_FAKE_STARTUP=1
export XDG_CONFIG_DIRS=$HOME/etc-xdg

mkdir -p "$XDG_CONFIG_DIRS/autostart" "$XDG_CONFIG_HOME/autostart" "$XDG_DATA_HOME/applications"
printf '[Desktop Entry]\nType=Application\nName=Network applet\nComment=Network status in the tray\nExec=nm-applet\n' \
  > "$XDG_CONFIG_DIRS/autostart/nm-applet.desktop"
printf '[Desktop Entry]\nType=Application\nName=Printer queue\nExec=system-config-printer-applet\n' \
  > "$XDG_CONFIG_DIRS/autostart/print-applet.desktop"
printf '[Desktop Entry]\nType=Application\nName=Syncthing\nComment=Keeps folders in step\nExec=syncthing\n' \
  > "$XDG_CONFIG_HOME/autostart/syncthing.desktop"
printf '[Desktop Entry]\nType=Application\nName=Firefox\nComment=The web\nExec=firefox %%u\nIcon=firefox\n' \
  > "$XDG_DATA_HOME/applications/firefox.desktop"
printf '[Desktop Entry]\nType=Application\nName=Terminal\nComment=A shell\nExec=foot\n' \
  > "$XDG_DATA_HOME/applications/foot.desktop"
mkdir -p "$XDG_STATE_HOME/eva/clock"
printf '[{"id":"a1b2c3","kind":"alarm","label":"gym","on":true,"hour":7,"minute":30,"days":[1,3,5],"at":1793613600}]' \
  > "$XDG_STATE_HOME/eva/clock/alarms.json"

note sh apps/startup/cli list
note sh apps/startup/cli disable nm-applet
note sh apps/startup/cli list
note cat "$XDG_CONFIG_HOME/autostart/nm-applet.desktop"
note sh apps/startup/cli enable nm-applet
note ls "$XDG_CONFIG_HOME/autostart"
note sh apps/startup/cli disable nm-applet
note sh apps/startup/cli timers

BOOT=4 start app startup
shot apps
appipc enable nm-applet > /dev/null
appipc tab add > /dev/null
appipc command "Night backup" "rsync -a ~/notes /mnt/backup" > /dev/null
pause 0.8
shot add
appipc tab apps > /dev/null
pause 0.8
shot apps-after
appipc tab scheduled > /dev/null
pause 0.8
shot scheduled
note appipc state
