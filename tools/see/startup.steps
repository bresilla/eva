# Startup on the sealed session: eva-startup's words on real files in the
# scratch XDG folders, then Settings' Startup apps page on the stand-in
# machine, with its timers, which this session's systemd does not have.
unset EVA_DRY_RUN
export XDG_CONFIG_DIRS=$HOME/etc-xdg

mkdir -p "$XDG_CONFIG_DIRS/autostart" "$XDG_CONFIG_HOME/autostart"
printf '[Desktop Entry]\nType=Application\nName=Network applet\nComment=Network status in the tray\nExec=nm-applet\n' \
  > "$XDG_CONFIG_DIRS/autostart/nm-applet.desktop"
printf '[Desktop Entry]\nType=Application\nName=Syncthing\nComment=Keeps folders in step\nExec=syncthing\n' \
  > "$XDG_CONFIG_HOME/autostart/syncthing.desktop"

note sh apps/bin/eva-startup list
note sh apps/bin/eva-startup disable nm-applet
note sh apps/bin/eva-startup list
note cat "$XDG_CONFIG_HOME/autostart/nm-applet.desktop"
note sh apps/bin/eva-startup enable nm-applet
note sh apps/bin/eva-startup timers

export EVA_DRY_RUN=1 EVA_FAKE_SYSTEM=1
start shell
ipc settings startup; pause 1.6; shot apps
