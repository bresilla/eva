# Updates on the sealed session: this repository's real flake.lock read and
# aged on Settings' Updates page, what managers this machine has really asked,
# then the canned log of a dry rebuild. EVA_DRY_RUN stays set: nothing here
# rebuilds anything.
export EVA_UPDATE_FLAKE=$SEE_EVA/flake.lock

note sh apps/bin/eva-update --check
start shell
ipc settings updates; pause 3; shot overview
