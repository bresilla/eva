# The desktop's widgets over a picture Eva paints, arranged, then the settings.
export EVA_SETTINGS=$XDG_STATE_HOME/see-settings.json
WALLS=$SEE_EVA/tests/fixtures/wallpapers
cat > "$EVA_SETTINGS" <<JSON
{ "lule": { "folder": "$WALLS" },
  "wallpaper": { "draw": true },
  "desktop": { "note": "Water the fern", "quiet_clock": true,
    "countdown": { "title": "New year", "date": "2027-01-01" },
    "widgets": {
      "desk": ["clock", "date", "weather", "system", "media", "visualiser", "calendar", "quote", "command", "orb"],
      "tablet": ["clock", "date", "weather", "media", "calendar"],
      "phone": ["clock", "date", "weather", "media", "system", "quote"] },
    "small": { "desk": ["visualiser"], "tablet": [], "phone": ["system", "date"] } } }
JSON
start shell
ipc wallpaper set "$WALLS/dusk.png"
pause 2.5
shot widgets
ipc desktop edit; pause 1.5; shot arranging
ipc desktop done; pause 0.5
ipc settings theme/desktop; pause 2.5; shot page
