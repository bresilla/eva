# Connection help on the stand-in machine (run with EVA_FAKE_SYSTEM=1): a network
# that wants a sign-in, then a walk that stops at DNS, then a speed test. The
# stand-in answers every request, so nothing leaves this session.
export EVA_FAKE_NET=portal
start shell
pause 0.8; shot portal-notice
ipc settings network; pause 1.2; shot network-page
ipc settings network/help; pause 1.2; shot help-portal
ipc fake-net no-dns; pause 0.8
key Tab; pause 0.2; key Tab; pause 0.2; key Return; pause 1.2; shot help-dns
