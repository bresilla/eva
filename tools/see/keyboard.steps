# The on-screen keyboard's panes, on a stand-in text field: EVA_FAKE_IME feeds
# what an input method would say.
export EVA_FAKE_IME=1
export EVA_SETTINGS=$XDG_STATE_HOME/keyboard-settings.json
mkdir -p "$XDG_STATE_HOME/eva/clipboard"
printf '[{"id":"1","kind":"text","text":"https://example.test/shared/link","pinned":true,"time":1},{"id":"2","kind":"text","text":"Meet at the north gate, 18:30","time":2},{"id":"3","kind":"text","text":"PIN is not kept here","time":3}]' > "$XDG_STATE_HOME/eva/clipboard/history.json"
start shell
ipc keyboard open; pause 1.6; shot keyboard-tools
ipc keyboard field 'Hello there'; pause 0.4
ipc keyboard field 'Good morning. Th'; pause 1.2; shot keyboard-predict
ipc keyboard field 'I will brin'; pause 0.4
ipc keyboard field 'Wierd'; pause 0.6; shot keyboard-fix
ipc keyboard field 'I love pizza'; pause 0.6; shot keyboard-emoji-name
ipc keyboard field 'Note '; pause 0.2
ipc keyboard tray clips; pause 0.6; shot keyboard-clips
ipc keyboard tray edit; pause 0.6; shot keyboard-edit
ipc keyboard tray words; pause 0.2
ipc keyboard pane emoji; pause 1.2; shot keyboard-emoji
ipc keyboard pane keys; pause 0.4
ipc keyboard hand right; pause 1.0; shot keyboard-right
ipc keyboard hand left; pause 1.0; shot keyboard-left
ipc keyboard hand both; pause 0.8
ipc keyboard floating on; pause 1.2; shot keyboard-floating
ipc keyboard floating off; pause 0.8
ipc keyboard language sq; pause 1.0; shot keyboard-sq
ipc keyboard language ru; pause 1.0; shot keyboard-ru
ipc keyboard language fr; pause 1.0; shot keyboard-fr
ipc keyboard language tr; pause 1.0; shot keyboard-tr
ipc keyboard language el; pause 1.0; shot keyboard-el
ipc keyboard language en; pause 0.8
ipc keyboard dev; pause 1.0; shot keyboard-dev
ipc keyboard phone; pause 1.0; shot keyboard-phone
ipc keyboard numbers; pause 1.0; shot keyboard-numbers
ipc keyboard full; pause 0.8
ipc settings keyboard; pause 1.4; shot keyboard-settings
