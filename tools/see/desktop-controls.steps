# The desktop control pages: window rules, saved layouts, the tray with a real
# item behind its arrow, external screens over the stand-in ddcutil, key
# remapping, a desk's menu in the overview, and eva-keys. A phone has only the
# ones that mean something there: SCREEN decides.
export EVA_FAKE_WINDOWS=1 EVA_FAKE_SYSTEM=1
export STUB_HYPR_BINDS="$SEE_EVA/tests/fixtures/binds.json"
export EVA_SETTINGS="$SEE_OUT/settings.json"
cat > "$EVA_SETTINGS" <<'JSON'
{ "edgebar": { "enabled": "on", "tray_items": [
  { "id": "nm-applet", "title": "Network applet", "place": "bar" },
  { "id": "see-tray", "title": "See tray", "place": "more" },
  { "id": "syncthing", "title": "Syncthing", "place": "hide" } ] },
  "windows": { "dim_inactive": true, "dim_strength": 0.3, "rules": [
    { "id": "r1", "class": "^firefox$", "layout": "float", "size": "1200 800", "workspace": "2", "opacity": 0.9 },
    { "id": "r2", "class": "^kitty$", "title": "^btop$", "workspace": "4", "silent": true, "no_blur": true } ] } }
JSON
start shell
WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1 WLR_RENDER_DRM_DEVICE=$RENDER \
  sway --unsupported-gpu -c "$CONFIG" > "$SEE_OUT/sway-item.log" 2>&1 &
pause 2
ITEM_DISPLAY=$(cd "$XDG_RUNTIME_DIR" && ls -d wayland-[0-9] | tail -1)
WAYLAND_DISPLAY=$ITEM_DISPLAY morf tools/see/tray_item.lua > "$SEE_OUT/tray-item.log" 2>&1 &
pause 3
shot bar
ipc layouts save work > /dev/null
pause 0.8
ipc utilities open; pause 1
ipc settings windows; pause 1.4; shot windows
ipc settings displays; pause 1.4; shot displays
ipc settings input; pause 1.4; shot input
if [ "${SEE_SCREEN%x*}" -gt 1000 ]; then
  ipc settings windows/rules; pause 1.4; shot rules
  ipc rules edit r1 > /dev/null; pause 1.4; shot rule
  ipc settings windows/layouts; pause 1.4; shot layouts
  ipc settings bar/tray; pause 1.4; shot tray
  ipc settings input/remap; pause 1.4; shot remap
  ipc close; pause 0.8
  ipc overview open; pause 1.5
  ipc overview_desk_menu 2; pause 0.8; shot overview-menu
  ipc overview_desk_menu 0; ipc overview close; pause 0.6
else
  ipc close; pause 0.8
fi
stop
start app keys
pause 1
shot keys
