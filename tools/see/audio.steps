# The mixer that was eva-audio, in the Settings window, against the stand-in
# for morf.audio: what plays, what records with its routing, the input's
# channels, the equalizer, its audiogram and the sound server's restart.
export EVA_FAKE_AUDIO=1

note sh apps/bin/eva-audio list
note sh apps/bin/eva-audio next

start shell
ipc settings sound; pause 1.4; shot output
ipc settings microphone; pause 1.2; shot input
ipc settings sound/equalizer; pause 1.2; shot equalizer
ipc settings sound/equalizer/audiogram; pause 1; shot audiogram
ipc settings sound/more; pause 1.2; shot more
