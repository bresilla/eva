# A phone's or a tablet's home: pages of apps and widgets, a hold's arranging, the
# launcher's grid with a folder, and the Desktop page.
#
#   SCREEN=868x1932 TOUCH=1 tools/see.sh home
#   SCREEN=1280x800 TOUCH=1 tools/see.sh home
mkdir -p "$XDG_DATA_HOME/applications"
for pair in "Browser:Network:web-browser" "Files:Utility:system-file-manager" "Terminal:System:utilities-terminal" "Notes:Office:" \
  "Paint:Graphics:" "Player:AudioVideo:" "Mail:Network:" "Chess:Game:" "Editor:Development:" "Photos:Graphics:" "Maps:Utility:"; do
  name=${pair%%:*}; rest=${pair#*:}; category=${rest%%:*}; icon=${rest#*:}
  printf '[Desktop Entry]\nType=Application\nName=%s\nComment=The %s app\nExec=true\nIcon=%s\nCategories=%s;\n' \
    "$name" "$name" "$icon" "$category" > "$XDG_DATA_HOME/applications/see-$name.desktop"
done
export EVA_SETTINGS=$XDG_STATE_HOME/see-settings.json
WALLS=$SEE_EVA/tests/fixtures/wallpapers
cat > "$EVA_SETTINGS" <<JSON
{ "lule": { "folder": "$WALLS" },
  "wallpaper": { "draw": true },
  "launcher": { "folders": [ { "name": "Work", "apps": ["see-Editor", "see-Notes", "see-Mail"] } ] },
  "dock": { "pins": ["see-Browser", "see-Mail", "see-Player"] },
  "desktop": {
    "widgets": {
      "tablet": ["clock", "date", "weather", "app:see-Browser", "app:see-Files", "app:see-Terminal", "app:see-Photos", "folder:Work"],
      "phone": ["clock", "date", "app:see-Browser", "app:see-Files", "app:see-Terminal", "app:see-Notes", "app:see-Photos", "folder:Work"] },
    "pages": {
      "tablet": [["media", "app:see-Chess", "app:see-Maps"]],
      "phone": [["media", "app:see-Chess", "app:see-Maps", "app:see-Paint"]] },
    "small": { "tablet": [], "phone": ["date"] } } }
JSON
start shell
ipc wallpaper set "$WALLS/dusk.png"
pause 2.5
shot home
ipc desktop page 2; pause 1.2; shot page2
ipc desktop page 1; pause 0.6
ipc desktop edit; pause 1.5; shot arranging
ipc desktop done; pause 0.5
ipc launcher open; pause 2; shot grid
ipc close; pause 0.6
ipc settings theme/desktop; pause 2.5; shot page
