# The dock on the window stand-in: on a desk when asked for, a tablet's taskbar.
export EVA_FAKE_WINDOWS=${EVA_FAKE_WINDOWS:-$SEE_EVA/tests/fixtures/windows.json}
export EVA_SETTINGS="$SEE_OUT/settings.json"
echo '{ "dock": { "enabled": "on", "autohide": "off", "pins": ["files", "notes"] } }' > "$EVA_SETTINGS"
start shell
pause 1.5; shot rest
ipc notify "Build finished" "eva" normal kitty; pause 1
ipc dock_magnify 180; pause 1.2; shot magnified
ipc dock_magnify; pause 0.8
ipc dock_menu 3; pause 0.8; shot menu
