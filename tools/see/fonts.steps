# The fonts, on the sealed session: eva-fonts' words with no shell, the font
# saved for the next start, then Settings' Fonts page and the running shell's
# `appearance font:NAME` verb taking one, a name with spaces whole.
unset EVA_DRY_RUN
appearance_file() { tr -d ' \n' < "$EVA_APPEARANCE"; }

note echo "--- list, no shell"
note sh -c 'sh apps/bin/eva-fonts list | wc -l'
note sh -c 'sh apps/bin/eva-fonts list --mono | head -n 3'
note sh apps/bin/eva-fonts current
FAMILY=$(sh apps/bin/eva-fonts list --mono | head -n 1)

note echo "--- saved with no shell"
note sh apps/bin/eva-fonts set "$FAMILY"
note echo "file: $(appearance_file)"
note sh apps/bin/eva-fonts reset
note echo "file after reset: $(appearance_file)"

start shell
ipc settings theme/fonts; pause 2; shot page
note echo "--- through the running shell"
note echo "before: $(ipc appearance state | cut -c1-140)"
note sh apps/bin/eva-fonts set "$FAMILY"
pause 2.5
note echo "after: $(ipc appearance state | cut -c1-140)"
shot set
note sh apps/bin/eva-fonts current
note echo "--- back"
note sh apps/bin/eva-fonts reset
pause 2.5
note echo "after reset: $(ipc appearance state | cut -c1-140)"
note echo "file: $(appearance_file)"
