# Two sealed outputs, each running the shell: the second keeps modules of its own,
# then the first keeps its bar down while the second stays up.
export EVA_FAKE_BATTERY=64 EVA_FAKE_STATUS=wifi
swaymsg create_output > /dev/null
pause 0.3
swaymsg output HEADLESS-2 mode 1280x720@60Hz > /dev/null
start shell
pause 2
ipc bar show on
pause 1.5
shot both
ipc bar output HEADLESS-2 own
pause 1
ipc bar output HEADLESS-2 add cpu
ipc bar output HEADLESS-2 add memory
ipc bar output HEADLESS-2 add disk
pause 2
shot own
ipc bar output HEADLESS-1 off
pause 2
shot one-down
ipc bar output HEADLESS-1 follow
ipc bar output HEADLESS-2 shared
pause 2
shot back
