# eva-screenshot on this private sway: asked by the shell, then alone. The screen
# is frozen from a picture of itself, morf.screencopy finding no format here.
unset EVA_DRY_RUN
CLI="sh apps/screenshot/cli"
FOLDER="$HOME/Pictures/Captures"
state() { toolipc state | tr -d '\\ \n' | cut -c1-140; }

start shell
export EVA_FAKE_SCREEN="$SEE_OUT/frozen.png"
pause 1
grim "$EVA_FAKE_SCREEN"

# Through the shell: it keeps the tool ready, and its verbs reach it.
$CLI --ask standby
pause 4
note echo "standby: $(state)"
shot standby
ipc capture open > /dev/null
pause 1.2
note echo "panel: $(state)"
note echo "shell sees: $(ipc capture state | tr -d ' \n')"
shot panel
ipc capture close > /dev/null
pause 1.2
note echo "closed: $(state)"
shot closed

ipc screenshot region > /dev/null
pause 1.5
note echo "selection: $(state)"
shot selection
key s
pause 1
note echo "editor: $(state)"
shot editor
ipc capture-editor tool rect > /dev/null
pause 0.5
shot editor-tool
ipc capture-editor cancel > /dev/null
pause 1
note echo "cancelled: $(state)"
stop

# Alone, no shell behind it: the same panel, flaring into the screen's edge.
$CLI &
TOOL=$!
pause 3.5
note echo "alone: $(state)"
shot alone-panel
toolipc capture close > /dev/null
pause 1.5
note echo "alone ended: $(ps -o pid= -p "$TOOL" | wc -l) running"

# A screen, saved through the selection and the editor's export, no shell.
$CLI screen --save > "$SEE_OUT/saved.txt" 2>&1
note echo "saved: $(cat "$SEE_OUT/saved.txt")"
note echo "in the folder: $(ls "$FOLDER" | wc -l) file(s)"
$CLI screen --copy >> "$SEE_OUT/saved.txt" 2>&1
note echo "clipboard: $(wl-paste --list-types 2>&1 | head -n 1)"
PICTURE=$(ls "$FOLDER"/*.png | head -n 1)

# The editor on a picture, no shell.
$CLI --edit-file "$PICTURE" &
TOOL=$!
pause 3.5
shot editor-file
note echo "editor on a file: $(state)"
toolipc capture-editor cancel > /dev/null
pause 1.5
note echo "file ended: $(ps -o pid= -p "$TOOL" | wc -l) running"
