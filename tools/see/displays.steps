# The arrangement that was eva-displays, on Settings' Displays page, over two
# sealed outputs: the canvas, a monitor moved, applied with its countdown,
# kept, and a profile saved. The shell's `displays` verb stands in for the
# pointer; tests/displays_spec.lua presses. Dry: nothing reaches the outputs.
layout() { swaymsg -p -t get_outputs | grep -E '^Output|Position|Scale|Transform' | tr -s ' ' | tr '\n' ' '; echo; }
swaymsg create_output > /dev/null
pause 0.3
start shell
note echo "start: $(layout)"
ipc settings displays; pause 1.6; shot rest

# HEADLESS-2 under HEADLESS-1: snapped from a little off.
ipc displays select HEADLESS-2 > /dev/null
ipc displays place HEADLESS-2 30 940 > /dev/null
pause 0.6
shot moved
note echo "draft: $(ipc displays state | grep -o 'dirty[^,]*')"

ipc displays apply > /dev/null
pause 0.8
shot countdown
ipc displays keep > /dev/null
ipc displays save-profile Desk > /dev/null
pause 0.6
shot kept

# A name on each monitor.
ipc displays identify > /dev/null
pause 1
shot identify
