# The machine's facts on the sealed session: this machine's own /proc, /sys and
# Nix links, sway's outputs through lib.shell.displays, on Settings' About page,
# then eva-info's words for real.
note sh apps/bin/eva-info --text
note sh -c 'sh apps/bin/eva-info --json | jq -r ".system.hostname, .versions.morf, (.nix.generation|tostring), .displays[0].name"'
start shell
ipc settings about; pause 3; shot top
