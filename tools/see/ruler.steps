# eva-ruler on the sealed sway: a real freeze with a tool window in it, edges
# found on it, the modes, a measure on the real clipboard, a second launch
# shutting it.
unset EVA_DRY_RUN
export EVA_FAKE_SCREEN_MM=${EVA_FAKE_SCREEN_MM:-344x215}
state() { appipc state | tr -d ' \n' | cut -c1-300; }
until_tool() { for _ in $(seq 80); do appipc state > /dev/null 2>&1 && return 0; sleep 0.25; done; }
drawn() { swaymsg -t get_tree | jq -e --arg id "$1" '[.. | objects | select(.app_id? == $id)] | length > 0' > /dev/null; }
until_window() { for _ in $(seq 80); do drawn "$1" && return 0; sleep 0.25; done; }
frozen() { for _ in $(seq 80); do state | grep -q '"frozen\\":true' && return 0; sleep 0.25; done; }

sh apps/launch keys > "$SEE_OUT/keys.log" 2>&1 &
until_window eva.keys
pause 3

BOOT=0.5 start app ruler
until_tool
frozen
pause 2
W=$(swaymsg -t get_outputs | jq -r '.[0].rect.width')
H=$(swaymsg -t get_outputs | jq -r '.[0].rect.height')
appipc point $((W / 2)) $((H / 3)) > /dev/null
pause 1
shot spacing
note echo "spacing: $(state)"

appipc copy > /dev/null
pause 0.5
note echo "clipboard: $(wl-paste -n 2>&1)"

appipc mode horizontal > /dev/null
appipc point $((W / 3)) 300 > /dev/null
pause 0.8
shot horizontal
note echo "horizontal: $(state)"

appipc mode vertical > /dev/null
appipc point $((W / 3)) 360 > /dev/null
pause 0.8
shot vertical
note echo "vertical: $(state)"

appipc mode bounds > /dev/null
appipc box 60 120 $((W / 2)) $((H / 2)) > /dev/null
pause 0.8
shot bounds
note echo "bounds: $(state)"

sh apps/ruler/cli
pause 1
note echo "second launch, role alive: $(kill -0 "$ROLE" 2>/dev/null && echo yes || echo no)"

# A mode from the command line, through the cli.
sh apps/ruler/cli vertical > "$SEE_OUT/vertical.log" 2>&1 &
ROLE=$!
until_tool
frozen
pause 1
note echo "from the cli: $(state)"
key Escape
pause 1
note echo "after Escape, role alive: $(kill -0 "$ROLE" 2>/dev/null && echo yes || echo no)"
note echo "stale handles: $(grep -c 'stale scene' "$SEE_OUT/vertical.log")"
ROLE=""
