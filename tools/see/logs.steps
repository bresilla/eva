# eva-logs on the sealed session: first the stand-in journal of tests/fixtures for
# the shots, a live follow arriving through morf.process.spawn, the filters and the
# last boot; then the machine's real journalctl, read and followed.
BOOT=7 start app logs
pause 3
shot follow
note echo "state: $(appipc state | cut -c1-200)"
appipc priority 3 > /dev/null
pause 1.5
shot warnings
appipc priority 1 > /dev/null
pause 1
appipc search nvme > /dev/null
pause 1
appipc select 1 > /dev/null
pause 1.5
shot chosen
appipc close > /dev/null
appipc search > /dev/null
appipc boot 2 > /dev/null
pause 1.5
shot last-boot
stop

export EVA_JOURNALCTL=/run/current-system/sw/bin/journalctl
BOOT=7 start app logs
pause 3
shot real
note echo "real: $(appipc state | cut -c1-260)"
