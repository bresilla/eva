# Quick settings with every hardware tile standing in: at rest, the pages of
# the hardware tiles and the tile editor.
export EVA_FAKE_HARDWARE=1 EVA_FAKE_MODEM=1
start shell
ipc settings; pause 1.4; shot overview
ipc settings hotspot; pause 1.2; shot hotspot
ipc settings nightlight; pause 1.2; shot nightlight
ipc quick edit; pause 1.2; shot editing
ipc quick done; pause 0.8; shot after-editing
