# The keyboard against a real text field from another program, on this private
# sway: zenity's GTK entry asks for text over text-input-v3, sway hands that to
# the shell as an input method, and what the keyboard commits lands in the entry.
# Needs zenity on PATH. EVA_FAKE_IME only drives the strikes: the field, its
# surrounding text, the commits and the deletes are the real protocol.
unset EVA_DRY_RUN
export EVA_FAKE_IME=1 GSK_RENDERER=cairo GTK_A11Y=none GDK_DEBUG=no-portals
export EVA_SETTINGS=$XDG_STATE_HOME/keyboard-ime.json
start shell
pause 2
zenity --entry --text='A real GTK field' --title=Field > "$SEE_OUT/zenity.out" 2>&1 &
pause 8
shot ime-1-field
note ipc keyboard read now
ipc keyboard type 'Hello'
pause 1
shot ime-2-typed
note ipc keyboard read now
ipc keyboard type ' th'
pause 1
shot ime-3-offers
note ipc keyboard read now
ipc keyboard pick 1
pause 1
shot ime-4-picked
note ipc keyboard read now
ipc keyboard type ','
pause 1
shot ime-5-swap
note ipc keyboard read now
ipc keyboard type 'done'
pause 0.5
ipc keyboard type ' '
pause 0.5
ipc keyboard type ' '
pause 1
shot ime-6-stop
note ipc keyboard read now
