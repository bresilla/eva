# The on-screen displays: each family at each kind of place.
export EVA_FAKE_OSD=1
start shell
shot rest
ipc osd volume; pause 0.9; shot volume
ipc osd mic; pause 0.9; shot volume-and-mic
pause 3.5
ipc osd media; pause 0.9; shot media
ipc osd headphones; pause 0.9; shot media-and-headphones
pause 4
