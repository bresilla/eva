# eva-large on the sealed sway: words from the command line, stdin and the real
# clipboard, the real qrencode, Escape ending it.
unset EVA_DRY_RUN
state() { appipc state | tr -d ' \n' | cut -c1-200; }
until_tool() { for _ in $(seq 60); do appipc state > /dev/null 2>&1 && return 0; sleep 0.25; done; }

printf 'copied words' | wl-copy
BOOT=0.5 start app large
until_tool
pause 1.2
shot clipboard
note echo "clipboard: $(state)"
stop

BOOT=0.5 start app large "Hello, world"
until_tool
pause 1.2
shot word
note echo "word: $(state)"

appipc show The quick brown fox jumps over the lazy dog while the band plays on and the night goes by > /dev/null
pause 1
shot long
note echo "long: $(state)"
key Escape
pause 1
note echo "after Escape, role alive: $(kill -0 "$ROLE" 2>/dev/null && echo yes || echo no)"
ROLE=""

printf 'from stdin\n' | sh apps/large/cli &
ROLE=$!
pause 2.5
shot stdin
sh apps/large/cli second launch
pause 1
note echo "second launch, role alive: $(kill -0 "$ROLE" 2>/dev/null && echo yes || echo no)"
ROLE=""
