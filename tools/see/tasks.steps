# Tasks and Calendar with a real list: full, filtered, searched, in the editor.
. "$SEE_EVA/tools/see/tasks_fill.sh"
start shell
ipc tasks open; pause 1.6; shot tasks-full
ipc calendar open; pause 1.6; shot calendar-full
stop
for uuid in $(task rc.verbose=nothing _uuids); do task rc.verbose=nothing rc.confirmation=off "$uuid" delete > /dev/null; done
start shell
ipc tasks open; pause 1.6; shot tasks-none
ipc calendar open; pause 1.2; shot calendar-none
