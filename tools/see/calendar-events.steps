# The calendar page with an event of each kind, the form for a new one, and a
# read-only calendar on the Calendars page. The files are made here.
export EVA_SETTINGS="$HOME/eva.json"
export TZ=UTC
STAMP=$(date -u -d "+2 hours" +%Y%m%dT%H0000Z)
TODAY=$(date -u +%Y%m%d)
cat > "$HOME/work.ics" <<ICS
BEGIN:VCALENDAR
VERSION:2.0
X-WR-CALNAME:Work
BEGIN:VEVENT
UID:see-1
SUMMARY:Design review
DTSTART:$STAMP
DURATION:PT1H
LOCATION:Room 2
RRULE:FREQ=WEEKLY
END:VEVENT
BEGIN:VEVENT
UID:see-2
SUMMARY:Conference
DTSTART;VALUE=DATE:$TODAY
END:VEVENT
END:VCALENDAR
ICS
cat > "$HOME/shared.ics" <<ICS
BEGIN:VCALENDAR
VERSION:2.0
X-WR-CALNAME:Shared
BEGIN:VEVENT
UID:see-3
SUMMARY:Team offsite
DTSTART;VALUE=DATE:$TODAY
END:VEVENT
END:VCALENDAR
ICS
chmod 444 "$HOME/shared.ics"
printf '{ "calendar": { "files": ["%s", "%s"] } }\n' "$HOME/work.ics" "$HOME/shared.ics" > "$EVA_SETTINGS"
start shell
drawn
ipc page calendar; pause 1.6; shot calendar
ipc event; pause 1.2; shot event-new
ipc close; pause 0.6
ipc settings calendars; pause 1.2; shot calendars-settings
