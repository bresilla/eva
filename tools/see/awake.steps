# Keep awake on the sealed session, against the real shell: eva-awake moves the
# shell's own keep awake, and the verb, the bar's coffee, the Keep awake tile and
# the Focus page all read the same state. The inhibitor is real, held on this sway.
unset EVA_DRY_RUN

# No shell yet.
note sh apps/bin/eva-awake status

BOOT=4 start shell
pause 1
note sh apps/bin/eva-awake 30m
note ipc awake state
pause 0.6
shot bar-on
ipc settings
pause 1.4
shot tile-on
ipc settings focus
pause 1.4
shot page-on

# The tile's own switch, seen by the page.
ipc awake off
pause 1
shot page-off
note sh apps/bin/eva-awake status

# A process keeps it awake, and letting go ends it.
sleep 3 &
sh apps/bin/eva-awake --pid $! >> "$SEE_OUT/notes.txt" 2>&1 &
pause 1.5
note ipc awake state
shot page-held
pause 5
note ipc awake state
